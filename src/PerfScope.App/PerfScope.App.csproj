<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>PerfScope.App</RootNamespace>
    <AssemblyName>PerfScope</AssemblyName>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>PerfScope</Product>
    <AssemblyTitle>PerfScope 应用级资源监控</AssemblyTitle>
    <Description>轻量常驻的 CPU / 内存监控工具，按应用聚合进程占用</Description>
    <Company>PerfScope</Company>
    <Version>1.0.0</Version>
    <Copyright>Copyright © 2026</Copyright>
    <SelfContained>false</SelfContained>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <!-- 内嵌图标：窗口 / 任务栏 / 托盘 / 对话框统一使用 -->
    <EmbeddedResource Include="Assets\app.ico" LogicalName="PerfScope.App.app.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PerfScope.Core\PerfScope.Core.csproj" />
  </ItemGroup>
</Project>