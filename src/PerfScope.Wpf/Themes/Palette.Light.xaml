<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 浅色 调色板：只放原始色值，画笔在 Themes/Controls.xaml 里统一派生 -->
    <Color x:Key="BgColor">#F5F6F8</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceAltColor">#F1F4F8</Color>
    <Color x:Key="BorderColor">#DDE1E6</Color>
    <Color x:Key="HeaderBgColor">#ECEEF1</Color>
