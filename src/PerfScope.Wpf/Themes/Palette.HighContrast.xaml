<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 高对比度 调色板：只放原始色值，画笔在 Themes/Controls.xaml 里统一派生 -->
    <Color x:Key="BgColor">#000000</Color>
    <Color x:Key="SurfaceColor">#000000</Color>
    <Color x:Key="SurfaceAltColor">#1A1A1A</Color>
    <Color x:Key="BorderColor">#FFFFFF</Color>
    <Color x:Key="HeaderBgColor">#000000</Color>
    <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
    <Color x:Key="TextSecondaryColor">#FFFFFF</Color>
    <Color x:Key="TextMutedColor">#C0C0C0</Color>
    <Color x:Key="AccentColor">#00FFFF</Color>
    <Color x:Key="AccentSoftColor">#000000</Color>
    <Color x:Key="CpuLineColor">#00FFFF</Color>
    <Color x:Key="MemoryLineColor">#FF00FF</Color>
    <Color x:Key="DangerColor">#FF0000</Color>
    <Color x:Key="WarningColor">#FFFF00</Color>
    <Color x:Key="SuccessColor">#00FF00</Color>
    <Color x:Key="RowHoverColor">#333333</Color>
    <Color x:Key="RowSelectedColor">#0055AA</Color>
    <Color x:Key="GridLineColor">#808080</Color>
    <Color x:Key="CaptionGlyphColor">#FFFFFF</Color>
    <Color x:Key="CaptionHoverBgColor">#333333</Color>
    <Color x:Key="CaptionHoverFgColor">#FFFFFF</Color>
    <Color x:Key="CaptionPressedBgColor">#666666</Color>
    <Color x:Key="TreemapTextColor">#FFFFFF</Color>
    <Color x:Key="TreemapSubTextColor">#FFFFFF</Color>
</ResourceDictionary>
