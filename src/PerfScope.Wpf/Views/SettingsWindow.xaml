<chrome:ChromeWindow x:Class="PerfScope.App.Views.SettingsWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:chrome="clr-namespace:PerfScope.App.Chrome"
                      xmlns:loc="clr-namespace:PerfScope.App.Localization"
                      Title="{loc:Loc '设置'}" Height="720" Width="880" MinHeight="560" MinWidth="760"
                      WindowStartupLocation="CenterOwner"
                      Icon="pack://application:,,,/Assets/app.ico">
    <chrome:ChromeWindow.Resources>
        
    <Style x:Key="LabelText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="FontSize" Value="{DynamicResource SmallFontSize}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,14,0"/>
    </Style>
    <Style x:Key="Row" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style x:Key="NumBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Width" Value="90"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    </chrome:ChromeWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Margin="14,10,14,0" SelectedIndex="{Binding SelectedTab}">
            <!-- ========== 采样与刷新 ========== -->
            <TabItem Header="{loc:Loc '采样与刷新'}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6,12">
                    <StackPanel>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LabelText}" Text="{loc:Loc '采样间隔（毫秒，500~10000）'}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource NumBox}" Text="{Binding SampleIntervalMs}"/>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LabelText}" Text="{loc:Loc '界面刷新间隔（毫秒，250~10000）'}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource NumBox}" Text="{Binding UiRefreshIntervalMs}"/>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LabelText}" Text="{loc:Loc '平滑窗口（采样点数，1~15）'}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource NumBox}" Text="{Binding SmoothingWindow}"/>
                        </Grid>
                        <CheckBox Content="{loc:Loc '主窗口隐藏时自动降频'}" IsChecked="{Binding AdaptiveThrottleWhenHidden}" Margin="0,0,0,10"/>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LabelText}" Text="{loc:Loc '隐藏时的采样间隔（毫秒）'}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource NumBox}" Text="{Binding HiddenSampleIntervalMs}"/>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource Border}" Margin="0,8,0,14"/>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LabelText}" Text="{loc:Loc 'CPU 百分比口径'}"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding CpuModeOptions}" SelectedValue="{Binding CpuMode}"
                                      SelectedValuePath="Value" DisplayMemberPath="Display" MaxWidth="340" HorizontalAlignment="Left"/>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LabelText}" Text="{loc:Loc '内存口径'}"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding MemoryModeOptions}" SelectedValue="{Binding MemoryMode}"
                                      SelectedValuePath="Value" DisplayMemberPath="Display" MaxWidth="340" HorizontalAlignment="Left"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========== 界面 ========== -->
            <TabItem Header="{loc:Loc '界面'}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6,12">
                    <StackPanel>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LabelText}" Text="{loc:Loc '主题'}"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding ThemeOptions}" SelectedValue="{Binding Theme}"
                                      SelectedValuePath="Value" DisplayMemberPath="Display" MaxWidth="340" HorizontalAlignment="Left"/>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LabelText}" Text="{loc:Loc '界面语言（切换后重启生效）'}"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding LanguageOptions}" SelectedValue="{Binding Language}"
                                      SelectedValuePath="Value" DisplayMemberPath="Display" MaxWidth="340" HorizontalAlignment="Left"/>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LabelText}" Text="{loc:Loc '列表显示行数（5~200）'}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource NumBox}" Text="{Binding TopN}"/>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LabelText}" Text="{loc:Loc '关闭按钮行为'}"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding CloseBehaviorOptions}" SelectedValue="{Binding CloseBehavior}"
                                      SelectedValuePath="Value" DisplayMemberPath="Display" MaxWidth="340" HorizontalAlignment="Left"/>
                        </Grid>
                        <CheckBox Content="{loc:Loc '启动时最小化到托盘'}" IsChecked="{Binding StartMinimized}" Margin="0,0,0,10"/>
                        <CheckBox Content="{loc:Loc '在状态栏显示自身开销'}" IsChecked="{Binding ShowSelfUsage}" Margin="0,0,0,10"/>
                        <CheckBox Content="{loc:Loc '在列表中显示 Windows 系统进程组'}" IsChecked="{Binding ShowSystemProcesses}" Margin="0,0,0,10"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========== 归并规则 ========== -->
            <TabItem Header="{loc:Loc '归并规则'}">
                <Grid Margin="6,12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <CheckBox Content="{loc:Loc '按版本信息（ProductName + CompanyName）归并'}" IsChecked="{Binding GroupByProductName}" Margin="0,0,0,8"/>
                        <CheckBox Content="{loc:Loc '按安装根目录归并（Program Files 等）'}" IsChecked="{Binding GroupByInstallRoot}" Margin="0,0,0,8"/>
                        <CheckBox Content="{loc:Loc '子进程继承父进程的应用归属'}" IsChecked="{Binding InheritParentGroup}" Margin="0,0,0,8"/>
                        <CheckBox Content="{loc:Loc '把 Windows 系统进程合并为单独一组'}" IsChecked="{Binding MergeWindowsSystemProcesses}" Margin="0,0,0,8"/>
                        <CheckBox Content="{loc:Loc '缓存 exe 版本信息（降低自身开销）'}" IsChecked="{Binding UseVersionInfoCache}" Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="150"/><ColumnDefinition Width="24"/><ColumnDefinition Width="130"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LabelText}" Text="{loc:Loc '兜底分组名'}"/>
                            <TextBox Grid.Column="1" Text="{Binding UnknownGroupName}"/>
                            <TextBlock Grid.Column="3" Style="{StaticResource LabelText}" Text="{loc:Loc '系统进程组名'}"/>
                            <TextBox Grid.Column="4" Text="{Binding SystemGroupName}"/>
                        </Grid>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Loc '自定义规则（自上而下优先匹配）'}"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <ListBox Grid.Row="0" ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}"
                                     Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                                     BorderThickness="1">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis" FontSize="12"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Style="{StaticResource SecondaryButton}" Content="{loc:Loc '新增'}" Command="{Binding AddRuleCommand}"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="{loc:Loc '删除'}" Margin="6,0,0,0" Command="{Binding RemoveRuleCommand}"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="{loc:Loc '上移'}" Margin="6,0,0,0" Command="{Binding MoveRuleUpCommand}"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="{loc:Loc '下移'}" Margin="6,0,0,0" Command="{Binding MoveRuleDownCommand}"/>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Column="2" Style="{StaticResource Card}"
                                Visibility="{Binding HasSelectedRule, Converter={StaticResource BoolToVis}}">
                            <StackPanel DataContext="{Binding SelectedRule}">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Loc '规则编辑'}"/>
                                <CheckBox Content="{loc:Loc '启用'}" IsChecked="{Binding Enabled}" Margin="0,0,0,10"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource LabelText}" Text="{loc:Loc '匹配'}"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding DataContext.RuleMatchOptions, RelativeSource={RelativeSource AncestorType=Border, AncestorLevel=2}}"
                                              SelectedValue="{Binding Match}" SelectedValuePath="Value" DisplayMemberPath="Display"/>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource LabelText}" Text="{loc:Loc '模式'}"/>
                                    <TextBox Grid.Column="1" Text="{Binding Pattern}"/>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource LabelText}" Text="{loc:Loc '动作'}"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding DataContext.RuleActionOptions, RelativeSource={RelativeSource AncestorType=Border, AncestorLevel=2}}"
                                              SelectedValue="{Binding Action}" SelectedValuePath="Value" DisplayMemberPath="Display"/>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource LabelText}" Text="{loc:Loc '目标名'}"/>
                                    <TextBox Grid.Column="1" Text="{Binding Target}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ========== 历史 ========== -->
            <TabItem Header="{loc:Loc '历史'}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6,12">
                    <StackPanel>
                        <CheckBox Content="{loc:Loc '把历史写入磁盘'}" IsChecked="{Binding EnableDiskHistory}" Margin="0,0,0,12"/>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LabelText}" Text="{loc:Loc '内存保留分钟数（5~1440）'}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource NumBox}" Text="{Binding MemoryRetentionMinutes}"/>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LabelText}" Text="{loc:Loc '磁盘保留天数（0~365，0 = 不落盘）'}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource NumBox}" Text="{Binding DiskRetentionDays}"/>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LabelText}" Text="{loc:Loc '趋势曲线应用数（1~64）'}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource NumBox}" Text="{Binding TrendAppSlots}"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========== 告警 ========== -->
            <TabItem Header="{loc:Loc '告警'}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6,12">
                    <StackPanel>
                        <CheckBox Content="{loc:Loc '启用阈值告警（托盘气泡）'}" IsChecked="{Binding EnableAlerts}" Margin="0,0,0,12"/>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LabelText}" Text="{loc:Loc '整机 CPU 阈值（%）'}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource NumBox}" Text="{Binding AlertCpuPercent}"/>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LabelText}" Text="{loc:Loc '整机内存阈值（%）'}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource NumBox}" Text="{Binding AlertMemoryPercent}"/>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LabelText}" Text="{loc:Loc '单应用 CPU 阈值（%，0 = 关闭）'}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource NumBox}" Text="{Binding AlertAppCpuPercent}"/>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LabelText}" Text="{loc:Loc '同一告警最小间隔（秒）'}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource NumBox}" Text="{Binding AlertCooldownSeconds}"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========== 智能分析 ========== -->
            <TabItem Header="{loc:Loc '智能分析'}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6,12">
                    <StackPanel>
                        <CheckBox Content="{loc:Loc '持续产出分析历史（事件流 / 日报 / 周报）'}" IsChecked="{Binding InsightEnabled}" Margin="0,0,0,12"/>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LabelText}" Text="{loc:Loc '应用 CPU 片段阈值（%）'}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource NumBox}" Text="{Binding InsightAppCpuPercent}"/>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LabelText}" Text="{loc:Loc '应用片段最短持续（秒）'}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource NumBox}" Text="{Binding InsightAppCpuSeconds}"/>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LabelText}" Text="{loc:Loc '内存增长阈值（MB/分钟）'}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource NumBox}" Text="{Binding InsightMemoryGrowthMbPerMinute}"/>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LabelText}" Text="{loc:Loc '整机高负载阈值（%）'}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource NumBox}" Text="{Binding InsightSystemCpuPercent}"/>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LabelText}" Text="{loc:Loc '系统片段最短持续（秒）'}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource NumBox}" Text="{Binding InsightSystemCpuSeconds}"/>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LabelText}" Text="{loc:Loc '低内存阈值（可用 %）'}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource NumBox}" Text="{Binding InsightLowMemoryPercent}"/>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LabelText}" Text="{loc:Loc '摘要窗口（分钟）'}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource NumBox}" Text="{Binding InsightDigestMinutes}"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ========== 诊断 ========== -->
            <TabItem Header="{loc:Loc '诊断'}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6,12">
                    <StackPanel>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LabelText}" Text="{loc:Loc '日志级别'}"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding LogLevelOptions}" SelectedValue="{Binding LogLevel}"
                                      SelectedValuePath="Value" DisplayMemberPath="Display" MaxWidth="340" HorizontalAlignment="Left"/>
                        </Grid>
                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LabelText}" Text="{loc:Loc '日志文件上限（KB，64~10240）'}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource NumBox}" Text="{Binding LogMaxKilobytes}"/>
                        </Grid>
                        <CheckBox Content="{loc:Loc '启动时自动检查更新（唯一的网络访问）'}" IsChecked="{Binding UpdateCheckEnabled}" Margin="0,0,0,10"/>
                        <CheckBox Content="{loc:Loc '开机自动启动（计划任务，保持管理员权限）'}" IsChecked="{Binding RunAtStartup}" Margin="0,0,0,14"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource SecondaryButton}" Content="{loc:Loc '打开数据目录'}" Command="{Binding OpenDataFolderCommand}"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="{loc:Loc '导出脱敏诊断包'}" Margin="8,0,0,0" Command="{Binding ExportDiagnosticsCommand}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextMuted}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- 底部按钮 -->
        <Border Grid.Row="1" Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource Border}"
                BorderThickness="0,1,0,0" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" Foreground="{DynamicResource TextMuted}"
                           FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButton}" Content="{loc:Loc '恢复默认'}" Command="{Binding ResetCommand}"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="{loc:Loc '保存'}" Margin="8,0,0,0" Click="OnSaveClick"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="{loc:Loc '取消'}" Margin="8,0,0,0" Click="OnCancelClick"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</chrome:ChromeWindow>
