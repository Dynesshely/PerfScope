<chrome:ChromeWindow x:Class="PerfScope.App.Views.AboutWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:chrome="clr-namespace:PerfScope.App.Chrome"
                      Title="关于 PerfScope" Height="520" Width="620"
                      WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
                      Icon="pack://application:,,,/Assets/app.ico">
    <Grid Margin="22,16,22,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Image Source="pack://application:,,,/Assets/app.ico" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel Margin="14,2,0,0">
                <TextBlock Text="PerfScope" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock x:Name="VersionLine" Text="v0.0.0" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="把几百个 Windows 进程归并成「应用」，让你看到是哪个应用在吃 CPU / 内存，而不是哪个 PID。"
                           TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" Margin="0,0,0,14"/>
                <TextBlock Text="轻量 · 常驻 · 离线 · 零遥测 · 无需安装运行时" Foreground="{DynamicResource TextPrimary}"
                           FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,14"/>
                <TextBlock Text="技术栈：.NET 10 + WPF（MVVM），零第三方 NuGet" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,0,6"/>
                <TextBlock Text="许可：MIT" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,0,6"/>
                <TextBlock Text="仓库：github.com/Dynesshely/PerfScope" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,0,0,6"/>
                <TextBlock x:Name="DataDirLine" Foreground="{DynamicResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="打开数据目录" Click="OnOpenDataDirClick"/>
            <Button Style="{StaticResource SecondaryButton}" Content="打开 GitHub" Margin="8,0,0,0" Click="OnOpenGitHubClick"/>
            <Button Style="{StaticResource PrimaryButton}" Content="关闭" Margin="8,0,0,0" Click="OnCloseClick"/>
        </StackPanel>
    </Grid>
</chrome:ChromeWindow>
