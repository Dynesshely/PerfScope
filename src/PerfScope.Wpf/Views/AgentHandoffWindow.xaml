<chrome:ChromeWindow x:Class="PerfScope.App.Views.AgentHandoffWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:chrome="clr-namespace:PerfScope.App.Chrome"
                      xmlns:loc="clr-namespace:PerfScope.App.Localization"
                      Title="{loc:Loc '接入 Agent'}" Height="640" Width="820"
                      WindowStartupLocation="CenterOwner"
                      Icon="pack://application:,,,/Assets/app.ico">
    <Grid Margin="18,14,18,14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="{loc:Loc '把这份 Prompt 交给任意 AI Agent，它就能读到今天的真实监控数据。'}"
                       Foreground="{DynamicResource TextSecondary}" FontSize="12.5" TextWrapping="Wrap"/>
            <TextBlock Text="{loc:Loc '生成后会同时刷新 analysis/ 下的日报（Markdown + JSON）；Prompt 里只包含本地路径与已算好的结论，不含任何网络上传。'}"
                       Foreground="{DynamicResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <TextBox Grid.Row="1" x:Name="PromptBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11.5"
                 Background="{DynamicResource SurfaceAlt}" Foreground="{DynamicResource TextPrimary}"
                 BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="10"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock x:Name="StatusLine" Foreground="{DynamicResource Success}" FontSize="11.5"
                       VerticalAlignment="Center" Margin="0,0,12,0"/>
            <Button Style="{StaticResource SecondaryButton}" Content="{loc:Loc '重新生成'}" Click="OnRegenerateClick"/>
            <Button Style="{StaticResource PrimaryButton}" Content="{loc:Loc '复制到剪贴板'}" Margin="8,0,0,0" Click="OnCopyClick"/>
            <Button Style="{StaticResource SecondaryButton}" Content="{loc:Loc '关闭'}" Margin="8,0,0,0" Click="OnCloseClick"/>
        </StackPanel>
    </Grid>
</chrome:ChromeWindow>
