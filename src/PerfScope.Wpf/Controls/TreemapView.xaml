<UserControl x:Class="PerfScope.App.Controls.TreemapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:PerfScope.App.Localization"
             xmlns:vm="clr-namespace:PerfScope.App.ViewModels"
             Background="Transparent" ClipToBounds="True">
    <Grid x:Name="Host">
        <ItemsControl ItemsSource="{Binding Tiles}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:TreemapTileViewModel}">
                    <Border Background="{Binding Fill}" CornerRadius="3" Width="{Binding Width}" Height="{Binding Height}"
                            Margin="1" ToolTip="{Binding ToolTipText}" SnapsToDevicePixels="True" ClipToBounds="True">
                        <Grid>
                            <StackPanel Margin="7,4" VerticalAlignment="Top" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource TreemapText}"
                                           FontSize="12" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding ShowLabel, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="{Binding ValueText}" Foreground="{DynamicResource TreemapSubText}"
                                           FontSize="10.5" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding ShowValue, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                            <!-- 应用图标：与旧版一致画在右下角，块太小就整体隐藏，避免压字 -->
                            <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,6,5"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="{Binding IconVisibility}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 空状态 -->
        <TextBlock Text="{loc:Loc '暂无数据'}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextMuted}" FontSize="12"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"/>

        <!-- 悬停卡片：跟随鼠标，显示完整名称与数值 -->
        <Border x:Name="HoverCard" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource Border}"
                BorderThickness="1" CornerRadius="6" Padding="10,7" IsHitTestVisible="False"
                Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="{Binding HoveredTile.DisplayName}" Foreground="{DynamicResource TextPrimary}"
                           FontSize="12" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding HoveredTile.ValueText}" Foreground="{DynamicResource TextSecondary}"
                           FontSize="11" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
